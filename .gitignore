# Isolation — 영상·추출 JSON (로컬/CI에서 생성)
backend1/metrics/isolation/data/raw/*
!backend1/metrics/isolation/data/raw/.gitignore
!backend1/metrics/isolation/data/raw/.gitkeep

backend1/metrics/isolation/data/artifacts/*
!backend1/metrics/isolation/data/artifacts/.gitkeep

backend1/metrics/isolation/data/models/*
!backend1/metrics/isolation/data/models/.gitignore
!backend1/metrics/isolation/data/models/.gitkeep
